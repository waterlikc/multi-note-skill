{
  "type": "animation",
  "id": "binary-search",
  "preset": "flow",
  "title": "二分查找：每次砍掉一半",
  "alt": "在有序数组中取中点、比较并缩小区间直到命中的动画",
  "caption": "目标 7：mid=2 得 5，左界右移；mid=4 得 9，右界左移；mid=3 命中。",
  "loop": true,
  "nodes": [
    {
      "id": "array",
      "label": "有序数组",
      "detail": "[1,3,5,7,9,11]",
      "tone": "ink"
    },
    {
      "id": "mid",
      "label": "取中点",
      "detail": "l + (r-l)/2",
      "tone": "muted"
    },
    {
      "id": "compare",
      "label": "比较",
      "detail": "a[mid] 与 7",
      "tone": "accent"
    },
    {
      "id": "hit",
      "label": "命中",
      "detail": "返回下标 3",
      "tone": "ok"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "array",
      "to": "mid",
      "label": "l=0, r=5"
    },
    {
      "id": "e2",
      "from": "mid",
      "to": "compare",
      "label": "mid=2 → 5"
    },
    {
      "id": "e3",
      "from": "compare",
      "to": "hit",
      "label": "缩到 a[3]=7"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "label": "确定有序区间",
      "detail": "l=0, r=5，前提是数组有序",
      "focus": [
        "array"
      ],
      "hold": 1.4
    },
    {
      "id": "s2",
      "label": "取中间位置",
      "detail": "mid=2，a[mid]=5，5 < 7",
      "focus": [
        "mid",
        "e1"
      ],
      "hold": 1.5
    },
    {
      "id": "s3",
      "label": "缩小区间再比较",
      "detail": "l=3；mid=4 得 9 > 7，r=3；mid=3",
      "focus": [
        "compare",
        "e2"
      ],
      "hold": 1.7
    },
    {
      "id": "s4",
      "label": "命中目标",
      "detail": "a[3]=7，返回下标 3",
      "focus": [
        "hit",
        "e3"
      ],
      "hold": 1.5
    }
  ]
}
